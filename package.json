		"bot",
		"bridge",
		"messaging",
		"remote-control"
	],
	"homepage": "https://github.com/Qusic/pi-telegram#readme",
	"bugs": {
		"url": "https://github.com/Qusic/pi-telegram/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Qusic/pi-telegram.git"
	},
