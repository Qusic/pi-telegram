		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@earendil-works/pi-agent-core": "0.87.0",
		"@earendil-works/pi-ai": "0.87.0",
		"@earendil-works/pi-coding-agent": "0.87.0",
		"@types/node": "^24.13.4",
		"npm": "^11.6.2",
		"semantic-release": "^25.0.9",
		"typebox": "1.3.27",
		"typescript": "^7.0.2"
	}
